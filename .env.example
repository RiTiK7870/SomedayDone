# Copy this file to .env and fill in your values. Never commit .env.
# The Supabase publishable (anon) key is safe in the app ONLY because RLS is enabled.
# Never put the service-role key or Google client secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
EXPO_PUBLIC_PRIVACY_URL=https://yourdomain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://yourdomain.com/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# Where you host public-page/index.html (e.g. GitHub Pages). Optional.
EXPO_PUBLIC_PUBLIC_PAGE_URL=https://yourname.github.io/somedaydone/

# Server-only keys. Do NOT add EXPO_PUBLIC_ to these names.
# Store them with: node scripts/push-secrets.js
OPENROUTER_API_KEY=your-openrouter-key
# Optional: pin a model, otherwise "openrouter/free" is used.
# OPENROUTER_MODEL=openrouter/free
